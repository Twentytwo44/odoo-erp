<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- We use an initial inventory adjustment for Odoo 15+ -->
        <record id="inventory_adjustment_initial" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_bt_wifi_module"/>
            <field name="inventory_quantity">100.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>
        
        <record id="inventory_adjustment_motor" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_motor"/>
            <field name="inventory_quantity">100.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_blade" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_blade"/>
            <field name="inventory_quantity">100.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_grill" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_grill"/>
            <field name="inventory_quantity">100.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_base" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_fan_base"/>
            <field name="inventory_quantity">100.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_control" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_control_board"/>
            <field name="inventory_quantity">100.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_remote" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_remote"/>
            <field name="inventory_quantity">50.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_sensor" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_temp_sensor"/>
            <field name="inventory_quantity">50.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_std" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_smart_fan_standard"/>
            <field name="inventory_quantity">10.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <record id="inventory_adjustment_pro" model="stock.quant">
            <field name="product_id" ref="smart_fan_erp.product_smart_fan_pro"/>
            <field name="inventory_quantity">5.0</field>
            <field name="location_id" model="stock.location" eval="obj().env.ref('stock.stock_location_stock').id"/>
        </record>

        <!-- A function call to apply the inventory adjustment automatically upon install -->
        <function model="stock.quant" name="action_apply_inventory">
            <value eval="[
                ref('smart_fan_erp.inventory_adjustment_initial'),
                ref('smart_fan_erp.inventory_adjustment_motor'),
                ref('smart_fan_erp.inventory_adjustment_blade'),
                ref('smart_fan_erp.inventory_adjustment_grill'),
                ref('smart_fan_erp.inventory_adjustment_base'),
                ref('smart_fan_erp.inventory_adjustment_control'),
                ref('smart_fan_erp.inventory_adjustment_remote'),
                ref('smart_fan_erp.inventory_adjustment_sensor'),
                ref('smart_fan_erp.inventory_adjustment_std'),
                ref('smart_fan_erp.inventory_adjustment_pro')
            ]"/>
        </function>
    </data>
</odoo>
