<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="vendor_chip_supplier" model="res.partner">
            <field name="name">ChipSupplier Co.</field>
            <field name="supplier_rank">1</field>
        </record>

        <record id="product_smart_fan_standard" model="product.product">
            <field name="name">Smart Fan Standard</field>
            <field name="type">product</field>
            <field name="categ_id" ref="smart_fan_erp.cat_smart_fan"/>
            <field name="list_price">1500.0</field>
            <field name="standard_price">1000.0</field>
            <field name="route_ids" eval="[(6, 0, [ref('mrp.route_warehouse0_manufacture'), ref('stock.route_warehouse0_mto')])]"/>
        </record>

        <record id="product_smart_fan_pro" model="product.product">
            <field name="name">Smart Fan Pro</field>
            <field name="type">product</field>
            <field name="categ_id" ref="smart_fan_erp.cat_smart_fan"/>
            <field name="list_price">2200.0</field>
            <field name="standard_price">1500.0</field>
            <field name="route_ids" eval="[(6, 0, [ref('mrp.route_warehouse0_manufacture'), ref('stock.route_warehouse0_mto')])]"/>
        </record>

        <record id="product_bt_wifi_module" model="product.product">
            <field name="name">Bluetooth/Wi-Fi Module</field>
            <field name="type">product</field>
            <field name="categ_id" ref="smart_fan_erp.cat_electronic_part"/>
            <field name="standard_price">120.0</field>
            <field name="purchase_ok" eval="True"/>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('vendor_chip_supplier'), 'price': 120.0, 'min_qty': 500.0})]" />
        </record>

        <record id="product_motor" model="product.product">
